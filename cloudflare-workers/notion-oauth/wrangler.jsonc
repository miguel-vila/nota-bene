{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notabene-oauth",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Custom URL scheme the iOS app listens on. The /oauth/notion/callback
    // handler forwards Notion's redirect (with code/state/error) to this URL.
    "APP_REDIRECT_SCHEME": "notabene://oauth/notion/callback"
  },
  // Per-endpoint, per-IP rate limit. Key is "<path>:<cf-connecting-ip>", so
  // each endpoint gets its own counter and IPs cannot cross-pollute. Numbers
  // are generous for legitimate OAuth flows (one request per endpoint per
  // attempt) and tight against scripted abuse.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
  // Secrets (set via `wrangler secret put`, do not commit):
  //   NOTION_CLIENT_ID
  //   NOTION_CLIENT_SECRET
}
