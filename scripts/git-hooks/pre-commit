#!/usr/bin/env bash
# Pre-commit hook: runs `swift test` in both Debug and Release configurations
# so the DEBUG-gated eval-capture code path doesn't rot silently in either
# direction (broken Debug → can't dogfood; broken Release → can't ship).
#
# Install by running: ./scripts/git-hooks/install.sh
#
# Skip the hook for a single commit with: git commit --no-verify
# (don't make a habit of it.)

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Only run tests when Swift sources / Package files actually changed.
# Saves ~5s on docs-only commits.
if ! git diff --cached --name-only | grep -qE '\.swift$|^Package\.swift$|^Package\.resolved$'; then
  echo "[pre-commit] no Swift changes staged, skipping tests"
  exit 0
fi

echo "[pre-commit] swift test (Debug — #if DEBUG branches active)"
if ! swift test --quiet; then
  echo ""
  echo "[pre-commit] tests FAILED in Debug build — aborting commit."
  exit 1
fi

echo "[pre-commit] swift test -c release (Release — #if DEBUG branches dropped)"
if ! swift test --quiet -c release; then
  echo ""
  echo "[pre-commit] tests FAILED in Release build — aborting commit."
  echo "[pre-commit] Non-debug code rotted? See docs/eval-capture.md."
  exit 1
fi

echo "[pre-commit] both build configurations OK"
